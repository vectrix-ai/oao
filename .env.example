DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/oao
OAO_POSTGRES_PORT=5432
APP_ORIGIN=http://127.0.0.1:5173
API_ORIGIN=http://127.0.0.1:3000
OAO_API_PORT=3000
OAO_RUNTIME_PORT=8788
OAO_CONSOLE_PORT=5173
AUTH_PROVIDER=development
NODE_ENV=development
VITE_OAO_API_MODE=http
VITE_OAO_API_PROXY_TARGET=http://127.0.0.1:3000

# Required to add or execute model and sandbox providers. Generate once with
# `openssl rand -base64 32` and supply the same platform key to API and runtime.
# OpenRouter/OpenAI API keys are entered in the console and stored encrypted in
# PostgreSQL per organization and project; they do not belong in this file.
OAO_CREDENTIAL_ENCRYPTION_KEY=

# Optional vendor-neutral telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# WorkOS is the production human-auth path. Set these only with
# AUTH_PROVIDER=workos and NODE_ENV=production.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_SECRET=
WORKOS_CALLBACK_URL=
