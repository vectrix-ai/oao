DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/oao
OAO_POSTGRES_PORT=5432
APP_ORIGIN=http://127.0.0.1:8080
API_ORIGIN=http://127.0.0.1:3000
OAO_API_PORT=3000
OAO_RUNTIME_PORT=8788
OAO_CONSOLE_PORT=8080
AUTH_PROVIDER=development
NODE_ENV=development
VITE_OAO_API_MODE=http
VITE_OAO_API_PROXY_TARGET=http://127.0.0.1:3000
# Set to true on a hosted web service after building apps/console. The API then
# serves the console and its SPA routes from the same origin as /v1.
OAO_SERVE_CONSOLE=false

# Required to add or execute model and sandbox providers. Generate once with
# `openssl rand -base64 32` and supply the same platform key to API and runtime.
# OpenRouter/OpenAI/Anthropic API keys are entered in the console and stored
# encrypted in PostgreSQL per organization and project; they do not belong in
# this file.
OAO_CREDENTIAL_ENCRYPTION_KEY=

# Optional vendor-neutral telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set AUTH_PROVIDER=workos to disable the deterministic development identity.
# Local WorkOS uses NODE_ENV=development and an exact local callback; hosted
# deployments use NODE_ENV=production and HTTPS origins/callbacks.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
# Optional refresh-cookie lifetime in seconds. Defaults to 400 days, matching
# the WorkOS AuthKit integration default. Access sessions remain short-lived.
WORKOS_COOKIE_MAX_AGE=34560000
WORKOS_WEBHOOK_SECRET=
WORKOS_CALLBACK_URL=http://127.0.0.1:8080/v1/auth/callback
