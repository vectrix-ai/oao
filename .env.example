DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/oao
OAO_POSTGRES_PORT=5432
APP_ORIGIN=http://127.0.0.1:5173
API_ORIGIN=http://127.0.0.1:3000
OAO_API_PORT=3000
OAO_RUNTIME_PORT=8788
OAO_CONSOLE_PORT=5173
AUTH_PROVIDER=development
NODE_ENV=development
VITE_OAO_API_MODE=http
VITE_OAO_API_PROXY_TARGET=http://127.0.0.1:3000

# The deterministic local path is the default and needs no provider keys.
OAO_ENABLE_HOSTED_MODELS=false
OAO_SANDBOX_PROVIDER=fake

# To opt into OpenRouter, set hosted mode, a runtime-approved preset array,
# and the provider key. Example preset model IDs must exist in the pinned catalog.
OAO_OPENROUTER_PRESETS_JSON=[]
OPENROUTER_API_KEY=

# To opt into Daytona, set OAO_SANDBOX_PROVIDER=daytona and its key.
# DAYTONA_TARGET is optional placement preference, not a residency guarantee.
DAYTONA_API_KEY=
DAYTONA_TARGET=
OAO_DAYTONA_EGRESS_JSON={"mode":"none"}

# Optional vendor-neutral telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# WorkOS is the production human-auth path. Set these only with
# AUTH_PROVIDER=workos and NODE_ENV=production.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_SECRET=
WORKOS_CALLBACK_URL=
