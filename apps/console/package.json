{
  "name": "@oao/console",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint src test e2e vite.config.ts playwright.config.ts",
