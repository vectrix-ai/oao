{
  "name": "oao",
  "version": "0.4.0",
  "private": true,
  "description": "Open managed-agent platform powered by Flue and PostgreSQL",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo run dev --parallel",
    "dev:local": "infra/compose/dev-local.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "oao": "node apps/cli/bootstrap/oao.mjs",
    "db:down": "infra/compose/down.sh",
    "db:migrate": "pnpm --filter @oao/db-postgres migrate",
    "db:up": "infra/compose/up.sh",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @oao/db-postgres test:integration && pnpm --filter @oao/api test:integration",
    "test:harness:fresh": "infra/compose/test-harness-fresh.sh",
    "test:stack:fresh": "node --env-file-if-exists=.env infra/compose/test-stack-fresh.mjs",
    "test:postgres:fresh": "infra/compose/test-fresh.sh",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
