{
  "name": "oao",
  "version": "0.0.0",
  "private": true,
  "description": "Open managed-agent platform powered by Flue and PostgreSQL",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  }
}
